{
  "title": "modern-web-app-01 - Service Overview",
  "schemaVersion": 16,
  "refresh": "10s",
  "panels": [
    {
      "title": "Request Rate (QPS)",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(http_requests_total{app=\"modern-web-app-01\"}[1m])"
        }
      ]
    },
    {
      "title": "P95 Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"modern-web-app-01\"}[5m])) by (le))"
        }
      ]
    },
    {
      "title": "Error Rate (%)",
      "type": "singlestat",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"modern-web-app-01\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{app=\"modern-web-app-01\"}[5m])) * 100"
        }
      ]
    }
  ]
}